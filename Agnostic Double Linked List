# diff stores XOR of previous and next node addresses
# next node = curr:diff XOR address of prev node
# addr(x) = the address of node x

!import io
!import lib
!import int

def Node {
int data;
int diff; #prev XOR next, as addresses
} Node;

create_node(int data) {
node:data = $data;
node:diff = NULL;
return node;
}

insert(Node head, int data) {
Node new_node = create_node(data);
new_node:diff = $(NULL ^ addr(head));        # new front: prev is NULL, next is head

if (head != NULL) {
head:diff = $(addr(new_node) ^ head:diff);   # old diff was NULL ^ next, so swap NULL for new_node
}

return new_node;                             # caller sets head = insert(head, data)
}

traverse(Node head) {
Node curr = $head;
Node prev = NULL;
Node next;

while (curr != NULL) {
print $curr:data;
next = (Node)$(curr:diff ^ addr(prev));      # XOR with prev's address, not prev's diff
prev = $curr;
curr = $next;
}
print "NULL";
}
